{
	"schemaVersion": 1,
	"id": "erbridge",
	"version": "${version}",
	"name": "Minecraft Ring",
	"description": "Minecraft movement, building and combat in Elden Ring through a native Windows bridge.",
	"authors": ["justbustin", "siddoff"],
	"contact": {
		"homepage": "https://github.com/siddoff/Minecraft-Ring",
		"sources": "https://github.com/siddoff/Minecraft-Ring",
		"issues": "https://github.com/siddoff/Minecraft-Ring/issues"
	},
	"license": "MIT",
	"icon": "assets/erbridge/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.ermc.bridge.ErBridgeMod"],
		"client": ["dev.ermc.bridge.client.ErBridgeClient"]
	},
	"mixins": [
		"erbridge.mixins.json",
		{
			"config": "erbridge.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
